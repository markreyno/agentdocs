{
  "name": "agentdocs",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/dev.ts",
    "dev:desktop": "concurrently -n web,electron-build,electron \"vite --port 5183 --strictPort\" \"tsc -b tsconfig.electron.json -w\" \"wait-on tcp:5183 dist-electron/main.cjs && cross-env ELECTRON_START_URL=http://localhost:5183 electron .\"",
    "build": "tsc -b tsconfig.app.json tsconfig.node.json && vite build",
    "build:shared": "tsc -b tsconfig.shared.json",
    "build:electron": "tsc -b tsconfig.electron.json",
    "dist:mac": "npm run build:shared && npm run build && npm run build:electron && electron-builder --mac",
    "dist:win": "npm run build:shared && npm run build && npm run build:electron && electron-builder --win",
    "dist:win:publish": "npm run dist:win -- --publish always",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "build": {
    "appId": "com.agentdocs.app",
    "productName": "agentdocs",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "dist-shared/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "markreyno",
        "repo": "agentdocs"
      }
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${productName}-Setup.${ext}"
    }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@tailwindcss/vite": "^4.3.2",
    "@tiptap/extension-color": "^3.27.1",
    "@tiptap/extension-text-align": "^3.27.1",
    "@tiptap/extension-text-style": "^3.27.1",
    "@tiptap/pm": "^3.27.1",
    "@tiptap/react": "^3.27.1",
    "@tiptap/starter-kit": "^3.27.1",
    "@upstash/redis": "^1.38.1",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^17.4.2",
    "electron-updater": "^6.8.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.2",
    "tiptap-pagination-plus": "^3.1.0"
  },
  "devDependencies": {
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/node": "^5.9.3",
    "@vitejs/plugin-react": "^4.5.2",
    "concurrently": "^10.0.3",
    "cross-env": "^10.1.0",
    "electron": "^41.7.1",
    "electron-builder": "^26.13.0",
    "tsx": "^4.23.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.10",
    "wait-on": "^9.0.10"
  }
}
