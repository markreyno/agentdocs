# Anthropic (required to enable web demo chat)
ANTHROPIC_API_KEY=

# Upstash Redis (required on Vercel; optional locally — falls back to memory)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Comma-separated browser origins allowed to call /api/*
# Include your production URL, e.g. https://agentdocs.vercel.app
DEMO_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: bump to reset client-cached demo usage counters
# DEMO_EPOCH=v1

# Optional model / budget knobs
# DEMO_MODEL=claude-haiku-4-5
# DEMO_MAX_TOKENS=2048
# DEMO_MAX_TOOL_ITERATIONS=4
# API_PORT=8787
